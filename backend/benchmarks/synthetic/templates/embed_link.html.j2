<!DOCTYPE html>
<html><head><meta charset="utf-8"><style>{{ css }}</style></head><body>
<h1>{{ profile.name }}</h1>
<div class="contact">
  <a href="mailto:{{ profile.email }}">{{ profile.email }}</a> |
  {{ profile.phone }} |
  <a href="https://example.com/{{ profile.case_id }}">portfolio</a> |
  {{ profile.location.raw }}
</div>

<h2>Skills</h2>
<ul class="skills-list">
{% for s in rendered_skills %}<li>{{ s }}{% if loop.first %} (see <a href="https://example.com/projects">examples</a>){% endif %}</li>
{% endfor %}</ul>

<h2>Experience</h2>
{% for e in profile.experience %}
<div class="experience-entry">
  <div class="entry-header">{{ e.title }} — <a href="https://example.com/{{ e.company | lower | replace(' ', '-') }}">{{ e.company }}</a></div>
  <div class="entry-meta">{{ e.location_raw }} | {{ e.dates }}</div>
  <ul class="entry-bullets">
  {% for b in e.bullets %}<li>{{ b }}</li>
  {% endfor %}</ul>
</div>
{% endfor %}

<h2>Education</h2>
{% for ed in profile.education %}
<div class="education-entry">
  <div class="entry-header">{{ ed.degree }}</div>
  <div class="entry-meta">{{ ed.institution }} | {{ ed.location_raw }} | {{ ed.dates }}</div>
</div>
{% endfor %}
</body></html>
