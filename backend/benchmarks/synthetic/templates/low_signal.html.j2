<!DOCTYPE html>
<html><head><meta charset="utf-8"><style>{{ css }}</style></head><body>
<h1>{{ profile.name }}</h1>
<div class="contact">{{ profile.email }} · {{ profile.location.raw }}</div>

<h2>Skills</h2>
<p>{{ rendered_skills | join(", ") }}</p>

<h2>Experience</h2>
{% for e in profile.experience %}
<p><strong>{{ e.title }}</strong>, {{ e.company }} ({{ e.dates }})</p>
{% endfor %}
</body></html>
